# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/bokle

# Authentication
JWT_ACCESS_SECRET=change-this-to-a-strong-secret
JWT_REFRESH_SECRET=change-this-to-a-different-strong-secret

# Redis (Upstash) — used for OTP cache, rate limiting, job queues
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=

# Termii (SMS)
TERMII_API_KEY=
TERMII_SENDER_ID=Bokle

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@bokle.ng

# Cloudinary (File uploads + ID documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRIVATE_FOLDER=bokle-private
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bokle-public

# Pusher (Real-time notifications)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# Google Maps (location display)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
